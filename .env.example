APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Worktree isolation ------------------------------------------------------
# See docs/worktree-isolation.md. Ports below are for THIS checkout; each
# worktree allocates its own upwards from the bases.

# Pin the Compose project name so the shared network has a predictable name.
# Defaults to this directory's name when unset.
# COMPOSE_PROJECT_NAME=laravel-worktrees

APP_PORT=80
VITE_PORT=5173

# The data services listen on this machine only: their passwords are Sail's
# well-known local ones.
FORWARD_DB_PORT=127.0.0.1:5432
FORWARD_REDIS_PORT=127.0.0.1:6379
FORWARD_MAILPIT_PORT=127.0.0.1:1025
FORWARD_MAILPIT_DASHBOARD_PORT=127.0.0.1:8025

# Where the app and Vite ports listen. 0.0.0.0 opens them to the network, e.g. to
# try a page on a phone over Wi-Fi.
# SAIL_BIND_ADDRESS=127.0.0.1

# The AWS CLI image that creates and removes buckets.
# WORKTREE_AWS_CLI_IMAGE=amazon/aws-cli:2.37.8

# Running more than one project on this machine? Give each its own band --
# port detection cannot see a project while it is stopped.
# WORKTREE_APP_PORT_BASE=8001
# WORKTREE_VITE_PORT_BASE=5174

# What `create` branches from. Defaults to the remote's default branch.
# WORKTREE_BASE_BRANCH=main

# Object storage (RustFS/MinIO): the variables that hold bucket names, each given
# a per-worktree bucket, and which of them allow anonymous reads.
# WORKTREE_BUCKETS="AWS_BUCKET AWS_PUBLIC_BUCKET"
# WORKTREE_PUBLIC_BUCKETS="AWS_PUBLIC_BUCKET"

# Databases your own tooling derives from a worktree's database name, dropped with it.
# WORKTREE_EXTRA_DATABASE_SUFFIXES="_pages_testing"

# Run inside each new worktree once it is up.
# WORKTREE_POST_CREATE="./vendor/bin/sail npx playwright install chromium"

# Ceilings on each app container, so parallel worktrees cannot starve each other.
# SAIL_CONTAINER_MEM_LIMIT=5g
# SAIL_CONTAINER_CPUS=0

# Seconds a run waits for another to release the lock.
# WORKTREE_LOCK_TIMEOUT=600
